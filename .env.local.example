# CloneCV local environment — copy to .env.local

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (AI Studio)
GEMINI_API_KEY=
# Default model for chat UI / PDF import (also exposed to the client via next.config)
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated selectable + auto-fallback chain
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash,gemini-2.5-flash,gemini-3.5-flash

# RAG retrieval (pgvector). Indexing always runs on publish; this flag only
# gates whether chat searches the index. Off = today's full-context behaviour.
RAG_RETRIEVAL_ENABLED=false
# Optional overrides — defaults are calibrated in lib/rag/constants.ts
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# RAG_FOCUS_THRESHOLD=0.64
# FAQ_SEMANTIC_THRESHOLD=0.72

# Upstash Redis (rate limits — required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kakao share (optional)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Inquiry email via Resend (optional)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=

# E2E integration tests (optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_SLUG=

# Playwright
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1
